{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "DATABASE_URL": {
      "description": "PostgreSQL connection string from Neon",
      "required": true
    },
    "JWT_SECRET": {
      "description": "JWT secret for token signing (generate with: openssl rand -base64 32)",
      "required": true
    },
    "NODE_ENV": {
      "description": "Environment (production/development)",
      "default": "production"
    },
    "VITE_API_URL": {
      "description": "API base URL (e.g., https://your-api.vercel.app)",
      "required": false
    }
  },
  "functions": {
    "api": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
