{
  "rules": {
    "market_data": {
      ".read": true,
      ".write": true
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "profiles": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["user_id"],
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "portfolios": {
      ".read": "auth != null",
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "holdings": {
      ".read": "auth != null",
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "orders": {
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "history": {
      ".read": "auth != null",
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "market_status": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "admin_settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "teams": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "team_members": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "team_invites": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}