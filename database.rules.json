{
  "rules": {
    "market_data": {
      ".read": true,
      ".write": true
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "profiles": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["user_id"],
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "portfolios": {
      ".read": "auth != null",
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "holdings": {
      ".read": "auth != null",
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "orders": {
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "history": {
      ".read": "auth != null",
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "market_status": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com' || auth.token.role === 'SUPERVISOR')"
    },
    "market_control_mode": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com' || auth.token.role === 'SUPERVISOR')"
    },
    "admin_settings": {
      ".read": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com' || auth.token.role === 'SUPERVISOR' || auth.token.role === 'ANALYST')",
      ".write": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com')"
    },
    "teams": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "team_members": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "team_invites": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "competitions": {
      ".read": "auth != null",
      "$competitionId": {
        ".write": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com' || auth.token.role === 'SUPERVISOR')"
      }
    },
    "competition_invites": {
      ".read": "auth != null",
      "$inviteId": {
        ".write": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com' || auth.token.role === 'SUPERVISOR')"
      }
    },
    "support_tickets": {
      ".read": "auth != null",
      "$ticketId": {
        ".write": "auth != null && (data.child('userId').val() === auth.uid || newData.child('userId').val() === auth.uid || auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com' || auth.token.role === 'SUPERVISOR' || auth.token.role === 'SUPPORT')"
      }
    },
    "staff": {
      ".read": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com' || auth.token.role === 'SUPERVISOR' || auth.token.role === 'ANALYST')",
      "$staffId": {
        ".write": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com')"
      }
    },
    "admin_audit": {
      ".read": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com' || auth.token.role === 'SUPERVISOR' || auth.token.role === 'ANALYST')",
      "$eventId": {
        ".write": "auth != null && (auth.token.role === 'SUPER_ADMIN' || auth.token.email === 'admin@yin.com' || auth.token.role === 'SUPERVISOR')"
      }
    }
  }
}
